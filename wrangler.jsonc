{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flare-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Non-secret config. Secrets (GITHUB_TOKEN, WEBHOOK_SECRET) are set with
  // `wrangler secret put` (see setup.md), never committed.
  //
  // Set exactly one scope:
  //   GITHUB_REPO "owner/repo"  - repo-scoped runners (works for user repos)
  //   GITHUB_ORG  "your-org"    - org-scoped runners (needs org admin)
  // This repo deploys itself as its own demo, so it points at GITHUB_REPO.
  "vars": {
    "GITHUB_REPO": "andrius/flare-runner",
    "RUNNER_GROUP_ID": "1",
    "RUNNER_LABELS": "self-hosted,cloudflare"
  },

  // `wrangler deploy` builds ./Dockerfile (linux/amd64) and pushes it. class_name
  // must match the Durable Object class below.
  //
  // instance_type: memory and disk are billed on what you PROVISION, for the whole
  // wall-clock life of the container; vCPU is billed on what you actually BURN. So
  // trim memory, never vCPU. Dropping to a predefined half-vCPU type (standard-1)
  // is a trap: CI jobs here run at 90-95% of one vCPU, so wall-clock roughly
  // doubles and the memory bill grows with it. A custom type keeps the full vCPU
  // and cuts only the provisioned memory. 4 GiB fits an Actions job with the
  // 1.34 GB image; raise memory_mib if your jobs OOM, or disk_mb if you build
  // large images. Custom types need vcpu >= 1.
  //
  // max_instances must be >= the widest job matrix that queues at once, AND your
  // Cloudflare account's concurrent-container limit caps real concurrency on top
  // of this. A matrix wider than that limit starves its tail (one container per
  // workflow_job:queued webhook, no re-trigger). Keep matrices <= the limit, or
  // raise it. See setup.md "Concurrency and matrix size".
  "containers": [
    {
      "class_name": "RunnerContainer",
      "image": "./Dockerfile",
      "max_instances": 5,
      "instance_type": { "vcpu": 1, "memory_mib": 4096, "disk_mb": 8000 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "RunnerContainer", "name": "RUNNER" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerContainer"] }]

  // Per-org reuse: copy this file, change `name` + `GITHUB_ORG` (+ RUNNER_GROUP_ID),
  // or add an "env": { "another-org": { ... } } block and deploy with `--env`.
}
